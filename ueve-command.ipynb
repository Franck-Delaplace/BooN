   "source": [
    "# Install BOON\n",
    "\n",
    "## 1. Clone the project from GitHub :\n",
    "\n",
    "**git clone https://github.com/Franck-Delaplace/BooN**\n",
    "## 2.  Change directory\n",
    "\n",
    "  **cd BooN**\n",
    "\n",
    "## 3.  Launch the graphical interface\n",
    "\n",
    "**python3 boonify.py**\n",
    "\n",
    "## 4. Possibiliy install packages\n",
    "\n",
    "pip install <package>\n",
    "pip2 install <package> "
   ]
