Cell[BoxData[{
 RowBox[{"Clear", "[", "TeXMathLabel", "]"}], "\n", 
 RowBox[{
  RowBox[{"TeXMathLabel", "::", "usage"}], "=", 
  "\"\<TeXMathLabel[v_] Transform a variable of the form Xi where i is an \
integer into \!\(\*SubscriptBox[\(x\), \(i\)]\)\>\""}], "\n", 
 RowBox[{
  RowBox[{"TeXMathLabel", "[", "v_Symbol", "]"}], ":=", "\n", 
  RowBox[{"ToString", "@", 
   RowBox[{"TeXForm", "@", 
    RowBox[{"First", "@", 
     RowBox[{"StringCases", "[", 
      RowBox[{
       RowBox[{"ToString", "[", "v", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"prefix", ":", 
          RowBox[{"(", 
           RowBox[{"LetterCharacter", ".."}], ")"}]}], "~~", 
         RowBox[{"suffix", ":", 
          RowBox[{"(", 
           RowBox[{"DigitCharacter", ".."}], ")"}]}]}], ":>", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{
          RowBox[{"Symbol", "[", "prefix", "]"}], ",", 
          RowBox[{"ToExpression", "[", "suffix", "]"}]}], "]"}]}]}], 
      "]"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TeXMathLabel", "[", "v_", "]"}], ":=", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Print", "@", 
     RowBox[{"FullForm", "[", "v", "]"}]}], ";", "v"}], 
   ")"}]}], "\n"}], "Input",
 CellChangeTimes->{{3.9352308818481464`*^9, 3.9352308818481464`*^9}, {
  3.9352310981224194`*^9, 3.935231109898239*^9}, {3.935231186228489*^9, 
  3.935231301046221*^9}, {3.935231363667631*^9, 3.9352314199175625`*^9}, {
