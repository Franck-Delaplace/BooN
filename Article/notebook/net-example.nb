                    RowBox[{"EdgeLabels", "\[Rule]", " ", "Automatic"}]}], 
                    "]"}], ",", " ", 
                   RowBox[{"VertexCoordinates", "->", "hposition"}]}], "]"}], 
                 ",", "\[IndentingNewLine]", 
                 RowBox[{"Map", "[", 
                  RowBox[{"StateToInteger", ",", 
                   RowBox[{"FindEquilibria", "[", "model", "]"}], ",", 
                   RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
                 RowBox[{"ImageSize", "->", "Small"}]}], "]"}]}], "]"}]}], 
            "}"}], "\[IndentingNewLine]", ",", 
           RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], "/@", 
     "selectedctrl"}], ",", "4"}], "]"}]}]], "Input",
