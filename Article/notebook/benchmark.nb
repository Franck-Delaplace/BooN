Cell[BoxData[{
 RowBox[{"Clear", "[", "GetMean", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GetMean", "[", 
    RowBox[{"data_", ",", "i_Integer"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"section", ",", " ", 
      RowBox[{"MeanAround", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "&"}], "/@", "section"}], "]"}]}], 
     "]"}], "/@", "data"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.940380224247053*^9, 3.940380277041542*^9}, {
  3.940573963664053*^9, 3.940573975944004*^9}},
 CellLabel->
  "In[364]:=",ExpressionUUID->"80b50ad0-1495-a64f-8af0-3b3eb4697e5f"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "MaxCallout", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxCallout", "[", 
   RowBox[{"data_Association", ",", " ", 
    RowBox[{"pos_", ":", "Automatic"}], ",", " ", 
    RowBox[{"color_", ":", "Black"}]}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"max", " ", "=", " ", 
      RowBox[{"Max", "[", "data", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"var", ",", "time"}], "}"}], ",", " ", 
        RowBox[{"If", " ", "[", 
         RowBox[{
          RowBox[{"time", "===", "max"}], ",", 
          RowBox[{"Callout", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"var", ",", "time"}], "}"}], ",", "time", ",", "pos", 
            ",", 
            RowBox[{"LabelStyle", "->", " ", 
             RowBox[{"{", 
              RowBox[{"14", ",", "Bold", ",", "color"}], "}"}]}]}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"var", ",", "time"}], "}"}]}], "]"}]}], "]"}], ",", 
      "data"}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.940573577829239*^9, 3.9405736395614395`*^9}, {
